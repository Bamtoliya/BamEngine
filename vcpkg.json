{
  "name": "bam-engine",
  "version-string": "0.1.0",
  "dependencies": [
    "fmt",
    {
      "name": "sdl3",
      "features": [ "vulkan" ],
      "platform": "!emscripten"
    },
    {
      "name": "sdl3",
      "platform": "emscripten"
    },
    "glm",
    "glaze",
    "stb",
    "cppcodec",
    "lz4",
    "entt",
    "meshoptimizer",
    {
      "name": "vulkan",
      "platform": "!emscripten"
    },
    {
      "name": "assimp",
      "platform": "!emscripten"
    },
    {
      "name": "imguizmo",
      "platform": "!emscripten"
    },
    {
      "name": "glslang",
      "platform": "!emscripten"
    },
    {
      "name": "spirv-tools",
      "platform": "!emscripten"
    },
    "spirv-cross",
    {
      "name": "efsw",
      "platform": "!emscripten"
    },
    {
      "name": "directxtex",
      "platform": "windows"
    },
    {
      "name": "directx-headers",
      "platform": "windows"
    },
    {
      "name": "imgui",
      "features": [
        "dx12-binding",
        "sdl3-binding",
        "vulkan-binding",
        "docking-experimental",
        "sdl3-renderer-binding",
        "sdlgpu3-binding"
      ],
      "platform": "!emscripten"
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [ "widgets" ],
      "platform": "windows"
    }
  ]
}
